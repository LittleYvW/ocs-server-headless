# Host-side listener. The container always listens on port 15319 internally.
OCS_BIND_ADDRESS=127.0.0.1
OCS_PORT=15319
OCS_MAX_BROWSERS=4
OCS_MIN_FREE_MEMORY_MB=0
OCS_MAX_CPU_PERCENT=0
# OCR address must be reachable from inside the container.
OCS_OCR_URL=
# Optional mirror for the script manager ZIP; empty uses the pinned official release.
OCS_SCRIPT_MANAGER_URL=
# Existing unpacked MV3 extensions inside the container; the automatic runner uses ScriptCat 1.5.
OCS_EXTENSIONS=[]
# Set the exact external HTTPS origin when using a reverse proxy.
OCS_ALLOWED_ORIGINS=
