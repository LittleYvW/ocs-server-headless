{
	"name": "ocs-server-headless",
	"version": "0.1.0",
	"private": true,
	"description": "Headless browser automation service with a Web management API",
	"packageManager": "pnpm@10.21.0",
	"scripts": {
		"build": "pnpm --filter @ocs-server/common build && pnpm --filter @ocs-server/server build",
		"typecheck": "pnpm --filter @ocs-server/common build && pnpm --filter @ocs-server/server typecheck",
		"lint": "prettier --check \"packages/server/**/*.{ts,cjs}\" \"packages/web-ui/src/**/*.{ts,vue,css}\" \"packages/web-ui/tests/**/*.cjs\" \"packages/web-ui/vite.config.ts\" \"packages/common/**/*.ts\"",
		"lint:fix": "prettier --write \"packages/server/**/*.{ts,cjs}\" \"packages/web-ui/src/**/*.{ts,vue,css}\" \"packages/web-ui/tests/**/*.cjs\" \"packages/web-ui/vite.config.ts\" \"packages/common/**/*.ts\"",
		"test": "pnpm --filter @ocs-server/common build && pnpm --filter @ocs-server/common test && pnpm --filter @ocs-server/server test",
		"prepare": "husky",
		"setup": "bash ./scripts/setup.sh",
		"dev": "pnpm --filter @ocs-server/common build && pnpm --filter @ocs-server/server dev",
		"start": "pnpm --filter @ocs-server/server start",
		"browser:install": "pnpm --filter @ocs-server/server browser:install",
		"smoke": "pnpm build && pnpm --filter @ocs-server/server smoke",
		"build:web": "pnpm --filter @ocs-server/web-ui build",
		"dev:web": "pnpm --filter @ocs-server/web-ui dev",
		"typecheck:web": "pnpm --filter @ocs-server/web-ui typecheck",
		"test:web": "pnpm --filter @ocs-server/web-ui test:e2e"
	},
	"devDependencies": {
		"@commitlint/cli": "^19.0.0",
		"@commitlint/config-conventional": "^19.0.0",
		"@types/node": "^22.0.0",
		"concurrently": "^9.2.1",
		"cz-conventional-changelog": "^3.3.0",
		"husky": "^9.0.0",
		"prettier": "^2.8.8",
		"typescript": "catalog:"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/LittleYvW/ocs-server-headless.git"
	},
	"keywords": [
		"ocs",
		"script",
		"playwright",
		"headless",
		"server",
		"automation",
		"typescript"
	],
	"author": "enncy",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/LittleYvW/ocs-server-headless/issues"
	},
	"homepage": "https://github.com/LittleYvW/ocs-server-headless#readme",
	"engines": {
		"node": ">=22.0.0",
		"pnpm": ">=10.0.0"
	},
	"config": {
		"commitizen": {
			"path": "./node_modules/cz-conventional-changelog"
		}
	}
}
