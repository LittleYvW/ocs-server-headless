OCS_HOST=127.0.0.1
OCS_PORT=15319
OCS_DATA_DIR=./data
OCS_MAX_BROWSERS=4
# Optional startup resource thresholds; 0 disables the corresponding check.
OCS_MIN_FREE_MEMORY_MB=0
OCS_MAX_CPU_PERCENT=0
# Compatible JSON OCR endpoint: POST {image} or {det_target,det_bg}.
# OCS_OCR_URL=http://127.0.0.1:8080/ocr
# Standard scripts automatically download and cache pinned ScriptCat when needed.
# OCS_SCRIPT_MANAGER_URL=https://your-mirror.example/scriptcat-chrome.zip
# Omit to generate data/admin.token. Node does not load this file automatically.
# OCS_AUTH_TOKEN=replace-with-at-least-32-random-characters
# OCS_BROWSER_EXECUTABLE_PATH=/absolute/path/to/chrome
# OCS_ALLOWED_ORIGINS=http://localhost:3000
# OCS_EXTENSIONS=["/absolute/path/to/unpacked-mv3-extension"]
# OCS_ENCRYPTION_KEY_FILE=/absolute/path/to/encryption.key
