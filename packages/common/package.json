{
	"name": "@ocs-server/common",
	"version": "0.0.1",
	"private": true,
	"description": "Shared validation and built-in automation for OCS Server Headless",
	"main": "./lib/index.js",
	"files": [
		"lib"
	],
	"types": "./lib/index.d.ts",
	"exports": {
		".": {
			"types": "./lib/index.d.ts",
			"default": "./lib/index.js"
		},
		"./automation": {
			"types": "./lib/automation.d.ts",
			"default": "./lib/automation.js"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "node -e \"require('node:fs').rmSync('lib', { recursive: true, force: true })\" && tsc",
		"test": "vitest run"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/LittleYvW/ocs-server-headless.git",
		"directory": "packages/common"
	},
	"keywords": [
		"ocs",
		"typescript"
	],
	"author": "enncy",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/LittleYvW/ocs-server-headless/issues"
	},
	"homepage": "https://github.com/LittleYvW/ocs-server-headless#readme",
	"dependencies": {
		"axios": "catalog:"
	},
	"devDependencies": {
		"@types/node": "^22.0.0",
		"playwright-core": "catalog:",
		"vitest": "catalog:"
	}
}
